# Token do bot gerado pelo @BotFather no Telegram (Obrigatório)
TELEGRAM_TOKEN=seu_token_do_telegram_aqui

# ID numérico do Telegram do Administrador (Opcional, padrão: 5599506814)
ADMIN_ID=5599506814

# Chave de API do Google Gemini (Obrigatório para recursos de IA)
GEMINI_API_KEY=sua_chave_do_google_ai_studio_aqui

# Banco de Dados Turso Cloud (Opcional: se não preenchidos, usa SQLite local alertas.db)
TURSO_DATABASE_URL=libsql://seu-banco-usuario.turso.io
TURSO_AUTH_TOKEN=seu_token_do_turso_aqui

# Intervalo em horas entre verificações automáticas (Opcional)
CHECK_INTERVAL_HOURS=3

# Fuso horário do bot (Padrão: America/Sao_Paulo)
TZ=America/Sao_Paulo
